# Build the Go agent with the Red Hat system-crypto toolchain.
ARG golang_image
ARG base_image
ARG bpf_builder_image

FROM ${golang_image} AS builder
ARG TARGETOS
ARG TARGETARCH
ENV GOPROXY=direct \
    CGO_ENABLED=1 \
    GOFIPS140=certified \
    GO_BUILD_TAGS=netgo,ebpf,core,strictfipsruntime,no_openssl \
    STATIC_LDFLAGS=
WORKDIR /workspace
COPY go.mod go.sum ./
RUN go mod download
COPY . ./
RUN make build-linux

# Generate the kernel type information used by CO-RE. This is a build-time
# artifact and does not need to be produced in the final FIPS runtime image.
FROM ${bpf_builder_image} AS vmlinuxbuilder
WORKDIR /vmlinuxbuilder
RUN microdnf install -y iproute procps-ng llvm clang make gcc \
    kernel-devel elfutils-libelf-devel zlib-devel libbpf-devel bpftool \
    && microdnf clean all
COPY . ./
RUN make vmlinuxh

# Compile CO-RE eBPF objects with Clang. No eBPF compilation occurs at runtime.
FROM ${bpf_builder_image} AS bpfbuilder
WORKDIR /bpfbuilder
RUN microdnf install -y iproute procps-ng llvm clang make gcc \
    kernel-devel elfutils-libelf-devel zlib-devel libbpf-devel \
    && microdnf clean all
COPY . ./
COPY --from=vmlinuxbuilder /vmlinuxbuilder/pkg/ebpf/c/vmlinux.h ./pkg/ebpf/c/
RUN make build-bpf

FROM ${base_image}
RUN microdnf install -y ca-certificates openssl-libs \
    && microdnf clean all
ENV GODEBUG=fips140=auto
WORKDIR /
COPY --from=builder /workspace/controller .
COPY --from=builder /workspace/aws-eks-na-cli .
COPY --from=builder /workspace/aws-eks-na-cli-v6 .
COPY --from=bpfbuilder /bpfbuilder/pkg/ebpf/c/tc.v4ingress.bpf.o .
COPY --from=bpfbuilder /bpfbuilder/pkg/ebpf/c/tc.v4egress.bpf.o .
COPY --from=bpfbuilder /bpfbuilder/pkg/ebpf/c/tc.v6ingress.bpf.o .
COPY --from=bpfbuilder /bpfbuilder/pkg/ebpf/c/tc.v6egress.bpf.o .
COPY --from=bpfbuilder /bpfbuilder/pkg/ebpf/c/v4events.bpf.o .
COPY --from=bpfbuilder /bpfbuilder/pkg/ebpf/c/v6events.bpf.o .
ENTRYPOINT ["/controller"]
